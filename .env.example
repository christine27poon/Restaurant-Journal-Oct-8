# Supabase connection. With both set the app uses Supabase; leave them empty to use local mock data.
# Copy to .env.local and fill in (Supabase Dashboard > Project Settings > API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable / anon key is safe in the browser: row-level security protects the data.
# Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
